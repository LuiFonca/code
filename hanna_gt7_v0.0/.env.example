# HANNA GT7 — configuração de exemplo
#
# Copie para `.env` e ajuste. O `.env` está no .gitignore e NUNCA deve ser
# commitado: é onde ficam token do Discord e chave de IA.
#
# Precedência: variável de ambiente > .env > padrão do código.
# Todo valor abaixo é opcional; o app sobe sem nenhum deles.

# ---------- TELEMETRIA ----------
# mock  = gerador sintético (padrão; roda sem PS5)
# udp   = GT7 real na rede
# replay = sessão gravada
GT7_TELEMETRY_SOURCE=mock

# IP do PlayStation. Sem padrão de propósito — um IP hardcoded no código foi
# um dos problemas que esta configuração veio resolver.
GT7_PS_IP=
GT7_SEND_PORT=33739
GT7_RECEIVE_PORT=33740
GT7_SAMPLE_RATE_HZ=60

# Acelera o tempo da fonte sintética (1.0 = tempo real).
# Útil para exercitar gravação e retenção sem esperar a sessão inteira.
GT7_MOCK_SPEED=1.0
GT7_BUFFER_SIZE=4096

# ---------- ARMAZENAMENTO ----------
# GT7_DATABASE_PATH=~/.hanna_gt7/hanna.db
# GT7_TELEMETRY_PATH=~/.hanna_gt7/telemetry

# Retenção por pista. 0 desliga a exclusão automática.
GT7_KEEP_RECENT_PER_TRACK=20
GT7_KEEP_BEST_PER_TRACK=5

# ---------- IA ----------
# Sem chave, a IA fica desligada e o resto da aplicação funciona normalmente.
GT7_AI_PROVIDER=anthropic
GT7_AI_MODEL=claude-opus-5
GT7_AI_FAST_MODEL=claude-haiku-4-5
# GT7_AI_API_KEY=sk-ant-...        <-- NUNCA commitar
GT7_AI_ENABLED=true

# ---------- DISCORD ----------
# GT7_DISCORD_TOKEN=...            <-- NUNCA commitar
GT7_DISCORD_PREFIX=!engineer
GT7_DISCORD_ENABLED=true

# ---------- LOGGING ----------
GT7_LOG_LEVEL=INFO
GT7_LOG_JSON=false
# GT7_LOG_FILE=~/.hanna_gt7/hanna.log
