# HANNA GT7 — configuração de exemplo
#
# Copie para `.env` e ajuste. O `.env` está no .gitignore e NUNCA deve ser
# commitado: é onde ficam token do Discord e chave de IA.
#
# ONDE ELE MORA: `~/.hanna_gt7/.env`, do lado do banco de dados. É o que faz a
# sua configuração sobreviver à troca de versão — antes ela ficava na pasta do
# programa, e descompactar uma versão nova numa pasta nova recomeçava do zero,
# com a fonte de volta em `mock` e o IP vazio.
#
# Um `.env` na pasta de onde o programa é lançado ainda vence, para quem mexe
# no código; na primeira vez ele é copiado para `~/.hanna_gt7/.env`, de modo que
# a próxima versão já nasça configurada.
#
# Precedência: variável de ambiente > .env > padrão do código.
# Todo valor abaixo é opcional; o app sobe sem nenhum deles.
#
# VOCÊ NÃO PRECISA EDITAR ESTE ARQUIVO NA MÃO. A página **Configurações** do
# programa (`python3 -m gt7app`) escreve aqui, preservando estes comentários.
# Ela também testa a conexão com o PS5 e avisa quando uma variável de ambiente
# está vencendo o que você salvou.

# ---------- TELEMETRIA ----------
# mock  = gerador sintético (padrão; roda sem PS5)
# udp   = GT7 real na rede
# replay = sessão gravada
GT7_TELEMETRY_SOURCE=mock

# IP do PlayStation. Sem padrão de propósito — um IP hardcoded no código foi
# um dos problemas que esta configuração veio resolver.
GT7_PS_IP=
GT7_SEND_PORT=33739
GT7_RECEIVE_PORT=33740
GT7_SAMPLE_RATE_HZ=60

# Acelera o tempo da fonte sintética (1.0 = tempo real).
# Útil para exercitar gravação e retenção sem esperar a sessão inteira.
GT7_MOCK_SPEED=1.0
GT7_BUFFER_SIZE=4096

# ---------- ARMAZENAMENTO ----------
# GT7_DATABASE_PATH=~/.hanna_gt7/hanna.db
# GT7_TELEMETRY_PATH=~/.hanna_gt7/telemetry

# Retenção por pista. 0 desliga a exclusão automática.
GT7_KEEP_RECENT_PER_TRACK=20
GT7_KEEP_BEST_PER_TRACK=5

# ---------- IA ----------
# O padrão é LOCAL e GRATUITO: um modelo pequeno na sua máquina, via Ollama.
#
#     ollama pull qwen3:4b   &&   ollama serve
#
# Sem o servidor no ar nada quebra: o conselho sai da análise da Fase 4, que é
# gratuita e determinística. Por isso a IA vem **desligada** por padrão — ligada
# sem servidor, ela só produz um aviso no log a cada volta.
#
# Para usar: suba o Ollama e troque para `true`, ou marque a caixa em
# Configurações.
GT7_AI_ENABLED=false
GT7_AI_PROVIDER=local

GT7_AI_LOCAL_URL=http://localhost:11434/v1
GT7_AI_LOCAL_MODEL=qwen3:4b
# Modelo do rádio. Sem isto, usa o mesmo de cima — com 4B, manter dois modelos
# carregados custa mais memória do que economiza em latência.
# GT7_AI_LOCAL_FAST_MODEL=qwen3:4b
# Máquina lenta pode precisar de mais. Estourar cai no conselho local.
GT7_AI_LOCAL_TIMEOUT_S=30

# ---------- IA na nuvem (opcional, EXIGE créditos pagos) ----------
# A assinatura do claude.ai NÃO dá acesso à API: são produtos separados, e a
# API exige créditos comprados no console.anthropic.com. Não existe camada
# gratuita. Custo medido neste projeto: ~US$ 0,13 por sessão de 20 voltas.
#
# Basta exportar a chave — o provedor passa a `anthropic` sozinho.
# GT7_AI_API_KEY=sk-ant-...        <-- NUNCA commitar
GT7_AI_MODEL=claude-opus-5
GT7_AI_FAST_MODEL=claude-haiku-4-5

# ---------- DISCORD ----------
# O bot roda DENTRO do programa, assinando o barramento no mesmo processo.
# Não há servidor para manter e não custa nada — a contrapartida é que ele só
# existe enquanto o programa estiver aberto (para telemetria, irrelevante).
#
#   pip3 install discord.py
#
# Token em https://discord.com/developers/applications → Bot → Reset Token.
# Habilite "MESSAGE CONTENT INTENT" na mesma página, ou os comandos não chegam.
# GT7_DISCORD_TOKEN=...            <-- NUNCA commitar
GT7_DISCORD_PREFIX=!engineer
GT7_DISCORD_ENABLED=true

# Para ONDE o bot escreve. Vazios = primeiro canal gravável que ele encontrar,
# em qualquer servidor — o que funciona por acidente com um servidor só e manda
# o debrief para um lugar arbitrário em qualquer outra configuração.
#
# Use o NOME, como aparece na barra lateral do Discord (o `#` é opcional). Se o
# nome não existir, o bot fica em silêncio e registra o motivo no log, em vez de
# publicar num canal que você não escolheu.
# GT7_DISCORD_GUILD=Meu Servidor
# GT7_DISCORD_CHANNEL=telemetria

# ---------- VOZ ----------
# Fala a nota de rádio em voz alta. Usa o sintetizador que o sistema já tem —
# `say` no macOS, SAPI no Windows, `espeak-ng` no Linux. Sem dependência nova.
# Desligada por padrão: som que aparece sem ser pedido assusta.
GT7_VOICE_ENABLED=false
# Nome da voz do sistema. Vazio usa a padrão, que segue o idioma da máquina.
# macOS: `say -v ?` lista as instaladas (Luciana e Felipe falam português).
# GT7_VOICE_NAME=Luciana
# Palavras por minuto. Acima do normal de propósito: nota lenta chega tarde.
GT7_VOICE_RATE=200
# Teto de duração de uma fala, em segundos.
GT7_VOICE_MAX_SECONDS=8

# ---------- CARRO (gráfico de volante) ----------
# O GT7 não transmite ângulo de volante, nem dimensão de carro — o catálogo do
# jogo traz nome e fabricante, mais nada. O gráfico de volante da Análise é a
# curvatura da própria trajetória convertida por estes dois números.
#
# Eles SÓ ESCALAM O EIXO desse gráfico: onde a mão entra, quanto tempo fica e
# quantas correções teve não depende deles. Nada mais no programa os lê.
#
# Referências:  Miata ~2,31 m e 15:1
#               GT3 de corrida ~2,55 m e 12:1
#               protótipo de Le Mans ~2,90 m e 11:1
GT7_WHEELBASE_M=2.60
GT7_STEERING_RATIO=15.0

# ---------- INTERFACE ----------
# dark | light. Nome desconhecido cai no padrão em vez de impedir a subida.
GT7_UI_THEME=dark
GT7_UI_START_PAGE=live

# ---------- LOGGING ----------
GT7_LOG_LEVEL=INFO
GT7_LOG_JSON=false
# GT7_LOG_FILE=~/.hanna_gt7/hanna.log
